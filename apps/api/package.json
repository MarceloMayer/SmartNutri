    "fastify": "^4.29.0",
    "fastify-plugin": "^4.5.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.11.5",
    "resend": "^6.20.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^18.19.95",
    "tsx": "^4.19.2",
    "typescript": "~5.4.5"
